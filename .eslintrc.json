{
    "env": {
      "commonjs": true,
      "es6": true,
      "node": true,
      "jest": true
    },
    "extends": [
      "airbnb-base"
    ],
    "globals": {
      "Atomics": "readonly",
      "SharedArrayBuffer": "readonly",
      "Service": "readonly",
      "Characteristic": "readonly",
      "Formats": "readonly",
      "Units": "readonly",
      "Perms": "readonly",
      "FakeGatoHistoryService": "readonly"
    },
    "parserOptions": {
      "ecmaVersion": 2018
    },
    "rules": {
      "max-classes-per-file": "off",
      "no-console": "off",
      "no-restricted-syntax": "off"
    }
  }